# 复制为服务器上的安装参数，然后执行:
#   sudo ./deploy/install.sh --config /root/ispweb-install.env
#
# 命令行里的同名参数会覆盖本文件。

DOMAIN=portal.example.com
# 分机部署指向管理端的门户 API 端口，不要指向管理端 443，也不要写 IP。
API_UPSTREAM=https://manager.example.com:8443
# 与 ISPmanager deploy/.env 的 PORTAL_API_SECRET 相同。本机回环调试可留空。
PORTAL_API_SECRET=
SSL_MODE=certbot
CERTBOT_EMAIL=admin@example.com
# 管理端使用自签证书时，把证书文件放到这里，或仅实验室设置 URL_GUARD_TLS_VERIFY=0
# URL_GUARD_CA_FILE=/root/certs/manager-fullchain.pem
# URL_GUARD_TLS_VERIFY=1

# 另两种证书方式:
# SSL_MODE=self-signed
# SSL_MODE=provided
# SSL_CERT=/root/certs/fullchain.pem
# SSL_KEY=/root/certs/privkey.pem
# SSL_TRUSTED=/root/certs/chain.pem

WITH_FAIL2BAN=0

# 另外允许用门户服务器公网 IP 经 HTTPS 访问。IP 不在 Let's Encrypt 证书里，浏览器会提示不受信任。
ALLOW_IP_ACCESS=0
# 留空自动探测。NAT 后的服务器填路由器出口公网 IP
PUBLIC_IP=
